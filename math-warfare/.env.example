# Public browser configuration: a URL only. Never put a provider key in VITE_*.
VITE_NPC_ENDPOINT=https://YOUR-CONVERSATION-SERVICE.vercel.app/api/npc

# Server only, configured as a Vercel secret. Model is fixed in api/npc.js.
NPC_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional local-only Hack Club preview: not enabled in the public game.
# NPC_PROVIDER=hackclub
# NPC_LOCAL_PRIVATE=true
# HACKCLUB_API_KEY=
